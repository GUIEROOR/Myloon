#!name=HTTPDNS 拦截器 Optimized
#!desc=合并 Kelee 与 Fries HTTPDNS 规则；删除拼多多显式拦截与高误杀泛 IP /d、/resolve 正则，改善拼多多图片加载。
#!author=Kelee, VirgilClyne, optimized by ChatGPT
#!homepage=https://github.com/Loon0x00/LoonManual
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png
#!category=去广告, 依赖
#!date=2026-05-17 02:06:05 +0800

# 优化说明：
# 1. 已去除 Fries 中 Pinduoduo HTTPDNS 显式 URL Rewrite。
# 2. 已去除 Kelee 中高误杀的泛 IP HTTPDNS 正则；这些正则会命中抓包里的 114.110.96.6/d4 与 114.110.97.97/v2/d。
# 3. 未添加拼多多 DIRECT 规则，避免插件改变你的全局分流；只是确保本插件不再拦截拼多多。

[General]
force-http-engine-hosts = 119.29.29.29:80, dns.weixin.qq.com:80, dns.weixin.qq.com:8080, dns.weixin.qq.com:443, 203.107.1.65:80, 203.107.1.66:80

