#!name=HTTPDNS 拦截器优化版（合并/去重）
#!desc=合并 Fries_HTTPDNS_Block 与 Kelee_Block_HTTPDNS；拦截常见 HTTPDNS/HTTPSDNS，确保请求回到 Loon DNS 框架；已移除指定电商平台相关拦截。
#!author=VirgilClyne, 可莉, optimized by ChatGPT
#!homepage=https://nsloon.app/docs/Plugin/
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png
#!tag=HTTPDNS, DNS, 去广告, 依赖
#!system=
#!system_version=
#!loon_version=3.2.4(787)
#!date=2026-05-16

# 说明：
# 1. 已合并两个来源并按 Loon 官方插件结构整理。
# 2. 已移除指定电商平台 HTTPDNS URL Rewrite 拦截段。
# 3. 已去重并统一规则逗号空格格式；保留 no-resolve 以避免无意义 DNS 查询。

[General]
force-http-engine-hosts = 119.29.29.29:80, dns.weixin.qq.com:80, dns.weixin.qq.com:8080, dns.weixin.qq.com:443, 203.107.1.65:80, 203.107.1.66:80

